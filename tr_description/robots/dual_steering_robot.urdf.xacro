<?xml version="1.0" ?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tr">
  <xacro:include filename="$(find tr_description)/robots/tr_robot.xacro"/>

  <xacro:arg name="yaml_path" default="$(find tr_kinematics_2ws)/config/aligned.yaml"/>

  <!-- tr robot -->
  <xacro:tr_robot
   yaml_path="$(arg yaml_path)">
  </xacro:tr_robot>
</robot>